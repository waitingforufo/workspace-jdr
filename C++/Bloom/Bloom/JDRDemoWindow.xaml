<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bloom.JDRDemoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bloom"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="JDRDemoWindow">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" 
                    Spacing="16" 
                    Padding="2"
                    Background="Gray">

            <TextBlock FontSize="22" Text="这是JDRDemoWindow独立窗口" />
            <TextBlock FontSize="14" Text="由MainWindow的按钮打开" />

            <!-- 关闭窗口按钮 -->
            <Button Content="关闭窗口" Click="Button_Click" />

            <!-- 打开本地图片按钮 -->
            <Button x:Name="OpenImgBtn"
                    Content="📂 打开本地图片"
                    Click="OpenImgBtn_Click" />

            <TextBlock Text="缩放:" VerticalAlignment="Center" />
            <Slider x:Name="ScaleSlider" 
                    Width="200" Minimum="1" Maximum="10" 
                    VerticalAlignment="Center"
                    ValueChanged="ScaleSlider_ValueChanged" />
            <TextBlock x:Name="ScaleText" VerticalAlignment="Center" MinWidth="50" />

            <!-- 切换颜色效果按钮 -->
            <Button x:Name="ColorEffectBtn"
                    Content="🎨 切换颜色效果"
                    Click="ColorEffectBtn_Click" />
        </StackPanel>

        <!-- 画图板 -->
        <canvas:CanvasControl x:Name="CanvasCntrl"
                              Grid.Row="1"
                              ClearColor="DarkGray"
                              Draw="CanvasCntrl_Draw" />
    </Grid>
</Window>
