<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 固定设计令牌： 间距，圆角， 字号， 字体 -->
    <!-- 固定值用 {StaticResource}引用即可，通常不需要 {ThemeResource} -->
    <!-- e.g.: 用法： {StaticResource BloomBodyFontFamily} -->

    <FontFamily x:Key="BloomBodyFontFamily">Segoe UI Variable Text</FontFamily>

    <x:Double x:Key="BloomBodyFontSize">14</x:Double>
    <x:Double x:Key="BloomTitleFontSize">20</x:Double>
    <x:Double x:Key="BloomCaptionFontSize">12</x:Double>
    
    <x:Double x:Key="BloomStackSpacing">8</x:Double>

    <Thickness x:Key="BloomPageMargin">24,24,24,24</Thickness>
    <Thickness x:Key="BloomCardPadding">16,14,16,14</Thickness>
    <Thickness x:Key="BloomCardMargin">0,0,0,12</Thickness>

    <CornerRadius x:Key="BloomCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="BloomControlCornerRadius">6</CornerRadius>
    
</ResourceDictionary>